# ORQEN LLM configuration (copy to .env and fill in)
# Provider: gemini | grok
ORQEN_LLM_PROVIDER=gemini
ORQEN_LLM_MODEL=gemini-3.5-flash-lite

# Provide the key for your chosen provider:
#   GEMINI_API_KEY / XAI_API_KEY
GEMINI_API_KEY=
XAI_API_KEY=

# Optional: base URL override for self-hosted / endpoint overrides
# ORQEN_LLM_BASE_URL=https://api.x.ai/v1

# Optional: GitHub personal access token for private repo clones
GITHUB_PAT=

# Optional: state home override (defaults to ~/.orqen).
# ORQEN_HOME=
